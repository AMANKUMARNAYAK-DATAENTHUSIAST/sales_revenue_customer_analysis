SQL Codes

# Total Revenue

SELECT SUM(quantity * unit_price) AS total_revenue
FROM ecom
WHERE order_status = 'DELIVERED';

# Revenue by Category

SELECT category, SUM(quantity * unit_price) AS revenue
FROM ecom
WHERE order_status = 'DELIVERED'
GROUP BY category
ORDER BY revenue DESC;

# Revenue by City

SELECT city, SUM(quantity * unit_price) AS revenue
FROM ecom
WHERE order_status = 'DELIVERED'
GROUP BY city
ORDER BY revenue DESC;

# Top Customers by Spending

SELECT customer_id, customer_name,
       COUNT(order_id) AS total_orders,
       SUM(quantity * unit_price) AS total_spent
FROM ecom
WHERE order_status = 'DELIVERED'
GROUP BY customer_id, customer_name
ORDER BY total_spent DESC
LIMIT 10;

# Repeat Customers

SELECT customer_id, customer_name, COUNT(order_id) AS order_count
FROM ecom
GROUP BY customer_id, customer_name
HAVING COUNT(order_id) > 1
ORDER BY order_count DESC;


# Order Status Analysis

SELECT order_status, COUNT(*) AS total_orders
FROM ecom
GROUP BY order_status;


# Cancellation Rate by Category

SELECT category,
       COUNT(CASE WHEN order_status = 'CANCELLED' THEN 1 END) * 100.0 /
       COUNT(*) AS cancellation_rate
FROM ecom
GROUP BY category
ORDER BY cancellation_rate DESC;


# Return Rate by Product

SELECT product,
       COUNT(CASE WHEN order_status = 'RETURNED' THEN 1 END) * 100.0 /
       COUNT(*) AS return_rate
FROM ecom
GROUP BY product
ORDER BY return_rate DESC;








# Cancellation Rate by City

SELECT city,
       COUNT(CASE WHEN order_status = 'CANCELLED' THEN 1 END) * 100.0 /
       COUNT(*) AS cancellation_rate
FROM ecom
GROUP BY city
ORDER BY cancellation_rate DESC;


# Monthly Order Volume


SELECT DATE_FORMAT(order_date, '%m-%y') AS month,
       COUNT(order_id) AS total_orders
FROM ecom
GROUP BY month
ORDER BY month;


# Monthly Revenue

SELECT DATE_FORMAT(order_date, '%m-%y') AS month,
       SUM(quantity * unit_price) AS revenue
FROM ecom
WHERE order_status = 'DELIVERED'
GROUP BY month
ORDER BY month;


# Payment Insights

SELECT payment_method, COUNT(*) AS total_orders
FROM ecom
GROUP BY payment_method
ORDER BY total_orders DESC;


# Cancellation Rate by Payment Method

SELECT payment_method,
       COUNT(CASE WHEN order_status = 'CANCELLED' THEN 1 END) AS cancelled_orders,
       COUNT(*) AS total_orders,
       COUNT(CASE WHEN order_status = 'CANCELLED' THEN 1 END) * 100.0 / COUNT(*) AS cancellation_rate
FROM ecom
GROUP BY payment_method
ORDER BY cancellation_rate DESC;

